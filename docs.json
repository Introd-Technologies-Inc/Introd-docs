{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Introd",
  "description": "Verified guides for setting up Introd, syncing your network, finding warm paths, and preparing introduction drafts.",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#046147",
    "light": "#57E3BA",
    "dark": "#08976E"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F6FBF8",
      "dark": "#07131A"
    }
  },
  "fonts": {
    "family": "Inter",
    "weight": 450
  },
  "logo": {
    "light": "/images/brand/logo-light.png",
    "dark": "/images/brand/logo-dark.png",
    "href": "/"
  },
  "favicon": {
    "light": "/images/brand/favicon.png",
    "dark": "/images/brand/favicon.png"
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search verified Introd product guides"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/workspace/saved-lists",
      "destination": "/workspace/collections"
    },
    {
      "source": "/companies/company-signals",
      "destination": "/companies"
    },
    {
      "source": "/introductions/intro-outcomes",
      "destination": "/introductions/track-requests"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://getintrod.ai"
      },
      {
        "label": "Privacy",
        "href": "https://getintrod.ai/legal/privacy"
      },
      {
        "label": "Support",
        "href": "mailto:help@getintrod.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.getintrod.ai"
    }
  },
  "footer": {
    "links": [
      {
        "title": "Use Introd",
        "items": [
          {
            "label": "Getting started",
            "href": "/getting-started/quickstart"
          },
          {
            "label": "Sync your network",
            "href": "/setup-network/sync-accounts"
          },
          {
            "label": "Prepare an introduction",
            "href": "/introductions/create-request"
          },
          {
            "label": "Chrome extension",
            "href": "/chrome-extension"
          }
        ]
      },
      {
        "title": "Trust",
        "items": [
          {
            "label": "Privacy & security",
            "href": "/privacy-security"
          },
          {
            "label": "Privacy policy",
            "href": "https://getintrod.ai/legal/privacy"
          },
          {
            "label": "Terms of service",
            "href": "https://getintrod.ai/legal/terms"
          },
          {
            "label": "Report a security issue",
            "href": "mailto:security@getintrod.ai"
          }
        ]
      },
      {
        "title": "Company",
        "items": [
          {
            "label": "Website",
            "href": "https://getintrod.ai"
          },
          {
            "label": "Open app",
            "href": "https://app.getintrod.ai"
          },
          {
            "label": "Contact support",
            "href": "mailto:help@getintrod.ai"
          }
        ]
      }
    ],
    "socials": {
      "linkedin": "https://www.linkedin.com/company/warm-intros"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.getintrod.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "root": "getting-started/quickstart",
            "pages": [
              "getting-started/index",
              "getting-started/create-account",
              "getting-started/connect-integrations",
              "getting-started/first-warm-introduction",
              "getting-started/definitions"
            ],
            "public": true
          },
          {
            "group": "Workspace",
            "icon": "layout-dashboard",
            "root": "workspace/home",
            "pages": [
              "workspace/collections",
              "workspace/contacts",
              "workspace/network",
              "workspace/missions",
              "workspace/settings"
            ],
            "public": true
          },
          {
            "group": "Setup Network",
            "icon": "user-round-cog",
            "root": "setup-network/index",
            "pages": [
              "setup-network/sync-accounts",
              "setup-network/import-contacts",
              "setup-network/invite-team",
              "setup-network/alumni-networks",
              "setup-network/groups"
            ],
            "public": true
          },
          {
            "group": "People",
            "icon": "users",
            "root": "people/index",
            "pages": [
              "people/search-people",
              "people/view-paths",
              "people/request-introductions",
              "people/relationship-insights"
            ],
            "public": true
          },
          {
            "group": "Companies",
            "icon": "building-2",
            "root": "companies/index",
            "pages": [
              "companies/company-intelligence",
              "companies/company-connectors",
              "companies/warm-paths-into-companies"
            ],
            "public": true
          },
          {
            "group": "Introductions",
            "icon": "handshake",
            "root": "introductions/index",
            "pages": [
              "introductions/opportunity-flow",
              "introductions/create-request",
              "introductions/track-requests",
              "introductions/best-practices"
            ],
            "public": true
          },
          {
            "group": "Chrome Extension",
            "icon": "chrome",
            "root": "chrome-extension/index",
            "pages": [
              "chrome-extension/installation",
              "chrome-extension/permissions",
              "chrome-extension/linkedin-integration",
              "chrome-extension/understanding-checkmarks",
              "chrome-extension/troubleshooting"
            ],
            "public": true
          },
          {
            "group": "Relationship Intelligence",
            "icon": "network",
            "root": "relationship-intelligence/index",
            "pages": [
              "relationship-intelligence/connector-ranking",
              "relationship-intelligence/trustrank-and-confidence",
              "relationship-intelligence/communities-and-networks"
            ],
            "public": true
          },
          {
            "group": "Privacy & Security",
            "icon": "shield-check",
            "root": "privacy-security/index",
            "pages": [
              "privacy-security/data-handling",
              "privacy-security/integration-data-usage",
              "privacy-security/oauth-permissions",
              "privacy-security/gdpr-and-deletion"
            ],
            "public": true
          },
          {
            "group": "Help",
            "icon": "life-buoy",
            "root": "support/index",
            "pages": [
              "faq/index"
            ],
            "public": true
          }
        ]
      }
    ]
  }
}
