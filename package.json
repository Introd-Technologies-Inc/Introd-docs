{
  "name": "@introd/docs",
  "private": true,
  "scripts": {
    "check": "npm run check:public && npm run validate:mintlify && npm run check:a11y",
    "check:a11y": "mintlify a11y --telemetry=false",
    "check:public": "node scripts/check-public-docs.mjs",
    "check:live": "node scripts/check-live-docs.mjs",
    "validate:mintlify": "mintlify validate --telemetry=false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "mintlify": "4.2.794"
  }
}
